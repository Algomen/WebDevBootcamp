<%- include('partials/header') %>

<h2 class="card-title edit">Edit Post</h2>
<form action="/updatepost/<%= postP.id %>" method="POST" class="new-post-form">
    <div class="form-group">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= postP.title %>" required>
    </div>
    <div class="form-group">
        <label for="body">Body:</label>
        <textarea id="body" name="body" class="form-control body-textarea" required><%= postP.body %></textarea>
    </div>
    <div class="text-center">
        <input type="submit" value="Submit" class="btn btn-primary custom-submit-btn">
    </div>
</form>

<%- include('partials/footer') %>
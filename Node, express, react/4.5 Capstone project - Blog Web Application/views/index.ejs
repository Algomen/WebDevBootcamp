<%- include('partials/header') %>

<% if (posts.length === 0) { %>
    <div class="alert alert-warning" role="alert">
        <p>No posts have been published yet. Click on the New Post bottom below and start writing.</p>
    </div>
<% } %>
<% posts.forEach(post => { %>
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="card-title"><%= post.title %></h2>
        <p class="card-text" id="post-<%= post.id %>"><%= post.body.substring(0, 100) %>...</p>
        <a href="/posts/<%= post.id %>" class="btn btn-secondary btn-sm float-right mt-2">Read more</a>
      </div>
    </div>
<% }); %>

<div class="text-center mt-4">
    <a href="/newpost" class="btn btn-primary custom-new-post">New Post</a>
</div>



<%- include('partials/footer') %>